#!/usr/bin/env bash
set -euo pipefail
# Points you at the isolated dev loop for iterating on the overlay and switcher without touching
# your real GNOME session. The actual launcher is `bin/zentab-devkit` — run THAT:
#
#   bin/zentab-devkit
#
# GNOME 49+ removed the old `--nested` flag. Its `--wayland` successor does NOT work for a
# nested session from inside a running Wayland login: the native backend already holds the seat,
# so `dbus-run-session -- gnome-shell --wayland` dies with EBUSY. The working replacement is
# `--devkit` (needs the `mutter-devkit` helper that ships with mutter), which `bin/zentab-devkit`
# launches inside a throwaway sandbox: it points XDG_*_HOME at a temp dir so the enable step
# writes to a sandbox dconf (never ~/.config) and the extension is symlinked into a sandbox
# extensions dir (never ~/.local/share). Your real GNOME Shell, its dconf, and its Alt+Tab are
# left completely alone.
#
# Iterate: edit source, run `bin/zentab-build`, then close and relaunch `bin/zentab-devkit` to
# pick up the new dist/extension.js (a plain extension reload isn't enough for an ESM bundle
# that's been re-written on disk).
#
# On NixOS glib-compile-schemas lives in the glib.dev output, so build under a nix shell:
#   nix shell nixpkgs#nodejs_24 nixpkgs#glib.dev -c bin/zentab-build
echo "The isolated dev loop lives in bin/zentab-devkit — run that instead:"
echo
echo "  nix shell nixpkgs#nodejs_24 nixpkgs#glib.dev -c bin/zentab-build   # build first"
echo "  bin/zentab-devkit                                                  # launch sandbox"
